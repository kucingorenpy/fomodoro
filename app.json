{
  "expo": {
    "name": "Fomodoro",
    "slug": "fomodoro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logofomodoro.png",
    "scheme": "fomodoro",
    "splash": {
      "image": "./assets/logofomodoro2.png",
      "resizeMode": "contain",
      "backgroundColor": "#17A3EF"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kingbojji11.fomodoro"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2e9b064-2958-456f-b99a-08d10c34e75c"
      }
    }
  }
}
